    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{
        "@type": "Question",
        "name": "What is bulk/mass email marketing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bulk/Mass Email marketing is the most known and effective way to promote your brand and reach your potential clients through the most formal way, Email marketing. You can reach thousands of clients and do marketing of your brand in one go."
        }
      }, {
        "@type": "Question",
        "name": "How can I send emails in bulk for free and promote my brand?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You can easily promote your brand or reach thousands of clients for free with a single click on EBox Marketing Solutions. Just sign up for free, and get started. <br/> <p><a href=https://www.eboxmarketing.com/UserRegistration> Click here</a> to complete the form with your information.</p>"
        }
      }, {
        "@type": "Question",
        "name": "What do I need to do to send free emails in bulk?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "You may need a list of emails of your clients in a .csv file which you can upload <a href=https://www.eboxmarketing.com/EmailMarketingTool> here</a>  and start redirecting your clients to your brand instantly."
        }
      }, {
        "@type": "Question",
        "name": "Where will I be able to see the analytics of the emails I have sent?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Once you have signed up and logged in with your credentials, you will be able to see your own Analytical Dashboard to monitor every email that has been sent, followed-up, opened or which are still unopened by the clients.  <br/> <p><a href=https://www.eboxmarketing.com/UserRegistration> Click here</a> to sign up and try it for free.</p>"
        }
      }, {
        "@type": "Question",
        "name": "Will I be able to follow them up with free bulk emails too?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, you will be able to follow them up and also you will be able to check whether your client has opened your email or not for absolutely free."}
        }]
    }
    </script>
